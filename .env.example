# Local demo. Set both to false before any real deployment.
ASAMA_DEMO_MODE=true
ASAMA_SEED=true
DATABASE_URL=sqlite:///./data/asama.db
ASAMA_DATA_DIR=./data

# Optional. Leave unset to use the local hashing embedder and playbook replies.
# ASAMA_EMBEDDINGS=openai
# ASAMA_USE_LLM=true
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
